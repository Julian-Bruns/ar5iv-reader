{
  "name": "ar5iv Reader",
  "short_name": "ar5iv",
  "id": "/",
  "description": "Read ar5iv papers offline and copy LaTeX from rendered math.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "background_color": "#f8f1e5",
  "theme_color": "#f45d31",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icons/maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+ar5iv",
      "url": "/receive?protocol=%s"
    }
  ],
  "share_target": {
    "action": "/receive",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
